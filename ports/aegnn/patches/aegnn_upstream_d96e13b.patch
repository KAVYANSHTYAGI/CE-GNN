+def _read_prophesee_dat(path: str):
+    """Correct Prophesee .dat reader for ATIS sensor (N-Cars format)."""
+    with open(path, "rb") as f:
+        # Skip ASCII header (lines starting with %)
+        while True:
+            pos = f.tell()
+            line = f.readline()
+            if not line.startswith(b'%'):
+                f.seek(pos)
+                break
+        # After header: 2 bytes (event_type, event_size) then events
+        ev_type = np.frombuffer(f.read(1), dtype=np.uint8)[0]
+        ev_size = np.frombuffer(f.read(1), dtype=np.uint8)[0]
+        # Each event: 8 bytes -> (t: uint32, data: uint32)
+        raw = np.frombuffer(f.read(), dtype=np.uint32)
+    
+    if len(raw) % 2 != 0:
+        raw = raw[:-1]
+    
+    t = raw[0::2].astype(np.float32)
+    data = raw[1::2]
+    
+    # ATIS encoding: x[0:14], y[14:28], p[28]
+    x = (data & 0x3FFF).astype(np.float32)             # bits 0-13
+    y = ((data >> 14) & 0x3FFF).astype(np.float32)     # bits 14-27
+    p = ((data >> 28) & 0x1).astype(np.float32)        # bit 28
+    p = p * 2.0 - 1.0   # {0,1} -> {-1,+1}
+    
+    # Filter to N-Cars sensor bounds (it's smaller than full ATIS)
+    mask = (x < 120) & (y < 100)
+    x, y, t, p = x[mask], y[mask], t[mask], p[mask]
+    
+    # Normalize time
+    if len(t) > 1:
+        t = t - t.min()
+        t = t / (t.max() + 1e-6) * 120.0
+    
+    return x, y, t.astype(np.float32), p
+
