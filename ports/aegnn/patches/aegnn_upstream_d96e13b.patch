+from aegnn.models.layer import MaxPooling, MaxPoolingX
+
+try:
+    from mamba_ssm import Mamba
+    HAS_MAMBA = True
+except ImportError:
+    HAS_MAMBA = False
+    print("[WARN] mamba_ssm not available, using GRU fallback")
+
+
+def _build_edge_attr(pos, edge_index):
+    if edge_index.size(1) == 0:
+        return torch.zeros((0, 3), dtype=torch.float32, device=pos.device)
+    src, dst = edge_index
+    delta = pos[dst] - pos[src]
+    delta = torch.nan_to_num(delta, nan=0.0, posinf=1.0, neginf=-1.0)
+    max_abs = delta.abs().max(dim=0).values.clamp(min=1e-6)
+    ea = ((delta / (2 * max_abs)) + 0.5).clamp(0.0, 1.0).float()
+    return torch.nan_to_num(ea, nan=0.5)
+
+
+def _spatiotemporal_cartesian(data: Data) -> Data:
+    data.edge_attr = _build_edge_attr(data.pos, data.edge_index)
+    return data
+
+
+class MambaBlock(nn.Module):
+    """Mamba block with residual + LayerNorm. Falls back to GRU if mamba_ssm unavailable."""
+    def __init__(self, d_model, d_state=16, d_conv=4, expand=2):
+        super().__init__()
+        self.norm = LayerNorm(d_model)
+        if HAS_MAMBA:
+            self.ssm = Mamba(d_model=d_model, d_state=d_state, d_conv=d_conv, expand=expand)
+        else:
+            # GRU fallback - bidirectional for symmetry
+            self.ssm = nn.GRU(d_model, d_model // 2, batch_first=True, bidirectional=True)
+
+    def forward(self, x, mask=None):
+        # x: [B, N, D]
+        residual = x
+        x = self.norm(x)
+        if HAS_MAMBA:
+            x = self.ssm(x)
+        else:
+            x, _ = self.ssm(x)
+        return residual + x
+
+
+class GraphRes(nn.Module):
+    """
+    Lightweight Graph-Mamba for ncars event classification.
+    
+    Pipeline:
+      1. Local: 2 SplineConv layers extract local spatial features
+      2. Coarsen: MaxPooling reduces graph size  
+      3. Global: Mamba processes events as sorted sequence (cheap O(N))
+      4. Readout: mean+max pool + small FC
+    
+    ~400K params, much faster than the 1.2M conv-heavy version.
+    """
+
+    def __init__(
+        self,
+        dataset,
+        input_shape: torch.Tensor,
+        num_outputs: int,
+        pooling_size=None,
+        bias: bool = True,
+        root_weight: bool = True,
+        dropout: float = 0.5,
+        edge_dropout: float = 0.0,
+        edge_dim: int = None,
+        d_model: int = 96,           # mamba hidden dim
+        n_mamba_layers: int = 4,     # how many mamba blocks
+    ):
+        super().__init__()
+        assert len(input_shape) == 3
+
+        dim = 3
+        kernel_size = 3
+        img_w, img_h = float(input_shape[0]), float(input_shape[1])
+        in_dim = int(input_shape[2])
+
+        if pooling_size is None:
+            pooling_size = (8.0, 8.0)
+        pool_voxel = [img_w / 2.0, img_h / 2.0]
+
+        self.dropout_p = dropout
+        self.d_model = d_model
+
+        # ---- Input lift ----
+        self.input_proj = Linear(in_dim, 48, bias=True)
+        self.input_bn = BatchNorm1d(48)
+
+        # ---- Local spatial encoder (2 SplineConvs only) ----
+        self.conv1 = SplineConv(48, 64, dim=dim, kernel_size=kernel_size, bias=bias, root_weight=root_weight)
+        self.bn1 = BatchNorm1d(64)
+        self.conv2 = SplineConv(64, d_model, dim=dim, kernel_size=kernel_size, bias=bias, root_weight=root_weight)
+        self.bn2 = BatchNorm1d(d_model)
+
+        # ---- Graph coarsening ----
+        self.pool_mid = MaxPooling(pooling_size, transform=_spatiotemporal_cartesian)
+
+        # ---- Mamba sequence encoder (the workhorse) ----
+        self.mamba_blocks = nn.ModuleList([
+            MambaBlock(d_model) for _ in range(n_mamba_layers)
+        ])
+        self.mamba_norm = LayerNorm(d_model)
+
+        # ---- Readout ----
+        # mean + max global pool only (Mamba already aggregated globally)
+        fc_in = d_model * 2
+        self.fc1 = Linear(fc_in, 128, bias=True)
+        self.bn_fc = BatchNorm1d(128)
+        self.fc2 = Linear(128, num_outputs, bias=True)
+
+        self._init_weights()
+
+    def _init_weights(self):
+        for m in self.modules():
+            if isinstance(m, Linear):
+                nn.init.kaiming_normal_(m.weight, nonlinearity='relu')
+                if m.bias is not None:
+                    nn.init.zeros_(m.bias)
+
+    def forward(self, data: torch_geometric.data.Batch) -> torch.Tensor:
+        x = data.x.float()
+        pos = data.pos.float()
+        edge_index = data.edge_index
+        batch = data.batch
+
+        # ---- Input lift ----
+        x = F.relu(self.input_bn(self.input_proj(x)))
+
+        # ---- Local spatial encoding ----
+        ea = _build_edge_attr(pos, edge_index)
+        x = F.relu(self.bn1(self.conv1(x, edge_index, ea)))
+        x = F.relu(self.bn2(self.conv2(x, edge_index, ea)))
+        x = torch.nan_to_num(x, nan=0.0, posinf=1.0, neginf=-1.0)
+
+        # ---- Graph coarsening ----
+        data.x = x
+        data.pos = pos
+        data.edge_index = edge_index
+        data.batch = batch
+        data = self.pool_mid(data.x, pos=data.pos, batch=data.batch,
+                             edge_index=data.edge_index, return_data_obj=True)
+        data.num_nodes = data.x.size(0)
+        x = data.x
+        pos = data.pos
+        batch = data.batch
+
+        # ---- Sort by time within each batch (CRITICAL for Mamba) ----
+        # pos[:, 2] is time. Sort each graph's nodes by time so Mamba sees temporal order.
+        # We sort globally by (batch_idx, time) which preserves batch grouping.
+        sort_key = batch.float() * 1e9 + pos[:, 2]
+        order = sort_key.argsort()
+        x = x[order]
+        batch_sorted = batch[order]
+        pos_sorted = pos[order]
+
+        # ---- Convert sparse [N_total, D] to dense [B, N_max, D] ----
+        # to_dense_batch handles padding automatically and gives us a mask
+        x_dense, mask = to_dense_batch(x, batch_sorted)  # [B, N_max, D], [B, N_max]
+
+        # ---- Mamba blocks ----
+        for block in self.mamba_blocks:
+            x_dense = block(x_dense, mask=mask)
+
+        x_dense = self.mamba_norm(x_dense)
+
+        # Zero out padded positions before pooling
+        x_dense = x_dense * mask.unsqueeze(-1).float()
+
+        # ---- Readout: masked mean + masked max ----
+        counts = mask.sum(dim=1, keepdim=True).clamp(min=1).float()
+        x_mean = x_dense.sum(dim=1) / counts                      # [B, D]
+        x_max = x_dense.masked_fill(~mask.unsqueeze(-1), -1e4).max(dim=1).values  # [B, D]
+
+        h = torch.cat([x_mean, x_max], dim=1)  # [B, 2D]
+
+        # ---- FC head ----
+        h = F.dropout(h, p=self.dropout_p, training=self.training)
+        h = F.relu(self.bn_fc(self.fc1(h)))
+        h = F.dropout(h, p=self.dropout_p, training=self.training)
+        return self.fc2(h)
+
