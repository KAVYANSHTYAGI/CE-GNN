+class NCaltech101(EventDataModule):
+ 
+    def __init__(self, batch_size: int = 64, shuffle: bool = True, num_workers: int = 8,
+                 pin_memory: bool = False, transform: Optional[Callable[[Data], Data]] = None):
+        # FIX: img_shape is (width, height) = (x_max, y_max) for N-Caltech101
+        super().__init__(img_shape=(240, 180), batch_size=batch_size, shuffle=shuffle,
+                         num_workers=num_workers, pin_memory=pin_memory, transform=transform)
+ 
+        # FIX: tuned to match reference AEGNN scale.
+        # Coordinates stay in pixel-like units (x: 0..240, y: 0..180, t: beta-rescaled µs).
+        # With beta=0.5e-5 and t in µs, a 50ms window spans t ≈ [0, 0.25] — on the same
+        # order of magnitude as a ~3-pixel radius, so r=3 makes metric sense.
+        pre_processing_params = {
+            "r": 5.0,
+            "d_max": 32,
+            "n_samples": 10000,
+            "sampling": True,
+        }
+        self.save_hyperparameters({"preprocessing": pre_processing_params})
+ 
+    @staticmethod
+    def read_label(raw_file: str) -> Optional[Union[str, List[str]]]:
+        return raw_file.split("/")[-2]
+ 
+    @staticmethod
+    def load(raw_file: str) -> Data:
+        with open(raw_file, "rb") as f:
+            raw_data = np.fromfile(f, dtype=np.uint8)
+        raw_data = np.uint32(raw_data)
+ 
+        # FIX 1: byte 0 is x, byte 1 is y (was swapped).
+        all_x = raw_data[0::5]
+        all_y = raw_data[1::5]
+        all_p = (raw_data[2::5] & 128) >> 7
+        all_ts = ((raw_data[2::5] & 127) << 16) | (raw_data[3::5] << 8) | (raw_data[4::5])
+ 
+        # FIX 2: DO NOT divide by 1e6. normalize_time() expects microseconds.
+        # Keeping t in µs is what makes beta=0.5e-5 land in the right range.
+        all_ts = all_ts.astype(np.float64)
+ 
+        all_p = all_p.astype(np.float64)
+        all_p[all_p == 0] = -1
+ 
+        events = np.column_stack((all_x, all_y, all_ts, all_p))
+        events = torch.from_numpy(events).float()
+ 
+        # FIX 3: node features = polarity only (1-d). Reference AEGNN does this.
+        # Putting t in x was redundant (already in pos) and scale-broken.
+        x = events[:, 3:4]  # polarity, shape [N, 1]
+ 
+        # pos = (x, y, t) — same convention as reference.
+        pos = events[:, :3]
+ 
+        return Data(x=x, pos=pos)
+ 
+    @functools.lru_cache(maxsize=100)
+    def map_label(self, label: str) -> int:
+        label_dict = {lbl: i for i, lbl in enumerate(self.classes)}
+        return label_dict.get(label, None)
+ 
+    def _prepare_dataset(self, mode: str):
+        out_dir = os.path.join(_PROCESSED_DIR, "train" if mode == "train" else "test")
+        raw_files = self.raw_files(mode)
+        class_dict = {cls: i for i, cls in enumerate(self.classes)}
+ 
+        jobs = []
+        for rf in raw_files:
+            cls_name = os.path.basename(os.path.dirname(rf))
+            fname = os.path.splitext(os.path.basename(rf))[0] + ".pt"
+            pf = os.path.join(out_dir, cls_name, fname)
+            if not os.path.exists(pf):
+                jobs.append((rf, pf, class_dict, self.hparams.preprocessing))
+ 
+        if not jobs:
+            print(f"All files processed for {mode}")
+            return
+ 
+        print(f"Processing {len(jobs)} files for {mode}")
+        for _, pf, _, _ in jobs:
+            os.makedirs(os.path.dirname(pf), exist_ok=True)
+ 
+        n_workers = min(self.num_workers or os.cpu_count(), len(jobs))
+        with mp.Pool(processes=n_workers) as pool:
+            for _ in tqdm(pool.imap_unordered(_process_one, jobs, chunksize=1),
+                          total=len(jobs)):
+                pass
+ 
+    def raw_files(self, mode: str) -> List[str]:
+        raw_dir = _TRAIN_DIR if mode == "train" else _TEST_DIR
+        return glob.glob(os.path.join(raw_dir, "*", "*.bin"))
+ 
+    @property
+    def classes(self) -> List[str]:
+        return sorted(os.listdir(_TRAIN_DIR))
+ 
+ 
+# ========================= CORE PROCESS =========================
+ 
+def _process_one(args):
+    rf, pf, class_dict, params = args
+ 
+    try:
+        data = NCaltech101.load(rf)
+        data.file_id = os.path.basename(rf)
+ 
+        label = NCaltech101.read_label(rf)
+        if label is not None:
+            data.y = torch.tensor([class_dict[label]])
+ 
+        if data.num_nodes < 2:
+            raise ValueError(f"Too few events: {rf}")
+ 
+        # FIX 4: guarantee monotonic timestamps before searchsorted.
+        # (N-Caltech101 files are usually sorted, but not always; searchsorted fails silently.)
+        if not torch.all(data.pos[1:, 2] >= data.pos[:-1, 2]):
+            order = data.pos[:, 2].argsort()
+            data.pos = data.pos[order]
+            data.x = data.x[order]
+ 
+        # FIX 5: take the LAST 50ms (not a middle window). Timestamps are in µs here,
+        # so 50ms = 50_000 µs.
+        WINDOW_US = 50_000.0
+        t_end = data.pos[-1, 2]
+        t_start = t_end - WINDOW_US
+ 
+        # idx0 = first event with t >= t_start; idx1 = one past the last event.
+        idx0 = int(torch.searchsorted(data.pos[:, 2], t_start).item())
+        idx1 = data.num_nodes
+ 
+        if idx1 - idx0 < 10:
+            raise ValueError(f"Too few events in 50ms window: {rf}")
+ 
+        data.pos = data.pos[idx0:idx1]
+        data.x = data.x[idx0:idx1]
+        data.num_nodes = data.x.size(0)
+ 
+        # ---------- sampling ----------
+        num_nodes = data.num_nodes
+        n_samples = params["n_samples"]
+ 
+        if num_nodes >= n_samples:
+            # sample without replacement
+            choice = torch.randperm(num_nodes)[:n_samples]
+        else:
+            # FIX 6: sample WITH replacement instead of perm.repeat(), which created
+            # exact duplicate nodes at identical (x,y,t) → zero-distance self-edges
+            # in the radius graph. randint gives random duplication that at least
+            # doesn't produce collocated points in overwhelming numbers.
+            keep = torch.arange(num_nodes)
+            extra = torch.randint(0, num_nodes, (n_samples - num_nodes,))
+            choice = torch.cat([keep, extra])
+ 
+        data.x = data.x[choice]
+        data.pos = data.pos[choice]
+        data.num_nodes = data.x.size(0)
+ 
+        # ---------- normalization ----------
+        # Time: beta-rescale microseconds → roughly [0, 0.25] for a 50ms window.
+        # This is the ONLY rescaling. x and y stay in pixel units (0..240, 0..180).
+        data.pos[:, 2] = normalize_time(data.pos[:, 2])
+        # DO NOT divide x by 240 or y by 180 — that would mismatch scales with t
+        # and break the radius graph metric. Reference AEGNN leaves them in pixels.
+ 
+        # ---------- radius graph ----------
+        # With x,y in pixels and t in [0, ~0.25], r=3 gives a 3-pixel spatial radius
+        # that also implicitly spans the whole temporal window (since t_max ≪ 3).
+        # This matches the reference implementation's geometric regime.
+        data.edge_index = radius_graph(
+            data.pos,
+            r=params["r"],
+            max_num_neighbors=params["d_max"],
+            loop=False,
+        )
+ 
+        if data.edge_index.size(1) == 0:
+            raise ValueError(f"No edges: {rf}")
+ 
+        # ---------- edge features ----------
+        # FIX 7: normalize with the GLOBAL radius r, not per-graph max.
+        # Per-graph max made every graph's edge scale identical, destroying the
+        # absolute-shape signal the classifier needs.
+        src, dst = data.edge_index
+        delta = data.pos[dst] - data.pos[src]
+        data.edge_attr = ((delta / (2.0 * params["r"])) + 0.5).float().clamp(0.0, 1.0)
+ 
+        torch.save(data, pf)
+ 
+    except Exception as e:
+        print(f"[ERROR] {rf}: {e}", flush=True)
+        raise e
+ 
